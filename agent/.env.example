# Ripar agent service configuration. Copy to agent/.env (gitignored) and fill in.
# The agent is an UNTRUSTED courier: it can only spend inside the PulseCosignEnforcer caps of the mandate the
# user's Ripar device signed; everything else needs the device's co-signature (HUMAN path).

# --- chain -----------------------------------------------------------------------------------------------------
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
# deployments JSON written by contracts/script/Deploy.s.sol (relative paths are relative to agent/)
DEPLOYMENTS=../contracts/deployments/10143.json

# --- agent signer (the redeemer / delegate of the mandate) ------------------------------------------------------
# local = a local dev key (below). PRODUCTION uses a Privy server wallet (AGENT_SIGNER=privy, not implemented yet:
# the PrivySigner stub throws "not configured"). Generate a FRESH key for development, e.g. `cast wallet new`.
# Do NOT use anvil's well-known dev keys on Monad testnet: those addresses carry EIP-7702 code there.
AGENT_SIGNER=local
AGENT_PRIVATE_KEY=
# PRIVY_APP_ID=
# PRIVY_WALLET_ID=
# PRIVY_WALLET_ADDRESS=

# --- ERC-8004 (optional): after a HUMAN redemption the agent calls RiparReputationRelay.attestApproval ------------
# register with `npm run register-erc8004 -- --broadcast`, then set the printed id here
# AGENT_ID=

# --- planner: Qwen (Alibaba Cloud Model Studio, OpenAI-compatible). Unset QWEN_API_KEY = deterministic planner ---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
# extra JSON merged into every chat.completions request (DashScope: disable thinking for non-streaming calls)
# QWEN_EXTRA_BODY={"enable_thinking":false}
# QWEN_MAX_ROUNDS=6

# --- HTTP API --------------------------------------------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# origins allowed by CORS (the companion app), comma separated
COMPANION_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# optional bearer token (Authorization: Bearer <token>) required on every POST and every GET except /health
# (GET /events also takes ?token=<token>); it also enables operator denies ({operator: true})
# AGENT_API_TOKEN=
# extra Host header names served, comma separated (localhost, IP literals and HOST are always accepted; anything
# else is refused against DNS rebinding)
# AGENT_ALLOWED_HOSTS=

# --- behaviour -------------------------------------------------------------------------------------------------
# DATA_DIR=./data
# INVOICES=./data/invoices.json
# co-sign expiry = chain time + this many seconds (at most 7 days: the device refuses more)
COSIGN_TTL_SECONDS=3600
# gas limit = estimate + this margin (Monad bills the gas LIMIT, keep it small)
GAS_MARGIN_PERCENT=20
# run one planner step every N seconds (0 = only on POST /run)
AUTO_RUN_SECONDS=0
