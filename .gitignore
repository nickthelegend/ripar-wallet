# Python / tooling
__pycache__/
*.pyc

# SolidWorks session + scratch
model/.sw_pid
model/_*.log
model/_stl_cache/
model/_test/
~$*

# Third-party vendor files (Waveshare copyright) - see cad/vendor/README.md to fetch them
cad/vendor/*.stp
cad/vendor/*.step
cad/vendor/*.rar
cad/vendor/*.pdf
model/parts/Board_ESP32S3_LCD2.SLDPRT

# Bambu Studio CLI scratch (regenerated by cad/slice_bambu.py)
print/bambu/_work_*/
print/bambu/_plate_*/
print/bambu/_presets/

# Raw web pages captured during research (third-party content, large)
research/raw/
research/evidence/

# stale/debug renders
model/renders/_*
model/renders/part_*
model/renders/inspect_*

# Internal hackathon planning notes stay LOCAL (never commit): only the CAD reviews + part dims are tracked
research/*
!research/design_review_fit.md
!research/design_review_print.md
!research/design_review_use.md
!research/DESIGN_REVIEW_FIXES.md
!research/parts_dimensions.json

# JavaScript workspaces (packages/*, agent, companion)
node_modules/
/packages/*/dist/
/agent/dist/
/companion/dist/
# written by scripts/dev-stack.sh (the local stack's deployments JSON and description)
/companion/public/devstack/
.env
.env.*
!.env.example
# agent runtime state (mandate, escalations, payments); the demo invoices are tracked
agent/data/*
!agent/data/*.example.json
*.tsbuildinfo
